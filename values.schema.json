{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "agent": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "description": "Mode of agent to install"
        },
        "token": {
          "type": [
            "string",
            "null"
          ],
          "description": "The agent authentication token"
        },
        "externalTokenSecret": {
          "type": "object",
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ],
              "description": "The name of an existing secret that contains the token"
            },
            "key": {
              "type": [
                "string",
                "null"
              ],
              "description": "The key in the secret that contains the token"
            }
          }
        }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "serviceAccount": {
          "type": "object",
          "properties": {
            "roleArn": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^$|^arn:aws[a-zA-Z-]*:iam::[0-9]{12}:role/.+$",
              "description": "IAM role ARN for tokenless (IRSA) mode, attached to the controller ServiceAccount via the eks.amazonaws.com/role-arn annotation"
            }
          }
        },
        "webhook": {
          "type": "object",
          "properties": {
            "excluded": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "podMatchExpressions": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "description": "Label selector requirements of pods excluded from the pod mutation webhook, rendered after the built-in ones. Only exclusion operators are allowed: In and Exists would restrict the webhook to the matching pods instead",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "key"
                    ],
                    "properties": {
                      "key": {
                        "type": "string",
                        "maxLength": 317,
                        "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$",
                        "description": "Label key: an optional DNS subdomain prefix and '/', then a name of at most 63 characters"
                      },
                      "operator": {
                        "type": "string",
                        "enum": [
                          "NotIn",
                          "DoesNotExist"
                        ],
                        "description": "Defaults to NotIn"
                      },
                      "values": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "items": {
                          "type": [
                            "string",
                            "number",
                            "boolean"
                          ],
                          "maxLength": 63,
                          "pattern": "^(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])?$",
                          "description": "Label value: at most 63 characters"
                        }
                      }
                    },
                    "if": {
                      "required": [
                        "operator"
                      ],
                      "properties": {
                        "operator": {
                          "const": "DoesNotExist"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "values": {
                          "maxItems": 0
                        }
                      }
                    },
                    "else": {
                      "required": [
                        "values"
                      ],
                      "properties": {
                        "values": {
                          "type": "array",
                          "minItems": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "httpsProxy": {
          "type": [
            "string",
            "null"
          ],
          "description": "HTTPS proxy URL"
        },
        "noProxy": {
          "type": [
            "string",
            "null"
          ],
          "description": "Comma-separated host/IP/CIDR list to bypass the proxy"
        }
      }
    }
  }
}
